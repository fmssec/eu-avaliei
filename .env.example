# URL pública absoluta do site. Obrigatória: og:image precisa ser URL absoluta.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Provider de metadados: "mock" (padrão) ou "tmdb"
MEDIA_PROVIDER=mock

# Chave da API do TMDB (v4 read access token). Só necessária se MEDIA_PROVIDER=tmdb.
TMDB_API_KEY=

# Livros (Open Library) — sem chave, ligado por padrão. "false" desliga.
BOOKS_ENABLED=true

# Jogos (IGDB) — exige um app registrado na Twitch em dev.twitch.tv/console.
# Sem os dois, jogos simplesmente não aparecem na busca.
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=
